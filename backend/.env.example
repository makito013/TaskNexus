PROJECTS_ROOT=/path/to/your/projects

# Porta do canal de hooks: um segundo listener HTTP, só em 127.0.0.1, que o
# hook Stop do Claude Code e os adaptadores MCP chamam de volta. Deixe vazio
# (ou remova) para desligar — aí as chamadas caem no fallback, a porta 8000 do
# próprio app. Só é necessário quando o app não serve HTTP simples na 8000
# (ex.: HTTPS na 443, como no deploy.ps1, que já seta isso sozinho).
# HOOK_LOOPBACK_PORT=8765

# Sobrescreve a URL base inteira usada por hooks e adaptadores MCP, quando nem
# o listener de loopback nem o fallback servem (proxy, container).
# HOOK_CALLBACK_BASE_URL=http://127.0.0.1:8000
